<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Тёмная Material-тема: цвета интерфейса дальше задаёт само приложение (Настройки → Оформление) -->
    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:colorAccent">#7C4DFF</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
    </style>
    <style name="DialogTheme" parent="@android:style/Theme.Material.Dialog.NoActionBar">
        <item name="android:colorAccent">#7C4DFF</item>
        <item name="android:windowBackground">@color/bg</item>
    </style>
</resources>
